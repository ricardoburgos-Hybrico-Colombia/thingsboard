# =================================================================
# HyVision - Configuración de Entorno para Docker
# Compatible con Windows (Docker Desktop) y Ubuntu (Docker Engine)
# =================================================================

# Versión del Stack (LTS 4.3 bajo Apache 2.0)
HYVISION_VERSION=4.3.1.6

# Puertos Expuestos en el Host
HYVISION_HTTP_PORT=8080
HYVISION_MQTT_PORT=1883
HYVISION_EDGE_PORT=7070
HYVISION_COAP_PORT=5683
POSTGRES_PORT=5432

# Base de Datos (PostgreSQL 16 + TimescaleDB)
POSTGRES_DB=hyvision
POSTGRES_USER=hyvision
POSTGRES_PASSWORD=hyvision_secure_pass_2026

# Asignación de Memoria JVM para Servidor de 16 GB RAM
# 6 GB para HyVision App, 4 GB para TimescaleDB, resto para el SO y buffers de I/O
JAVA_OPTS=-Xms2048m -Xmx6144m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
