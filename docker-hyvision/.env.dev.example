# =================================================================
# HyVision — entorno de DESARROLLO (misma VPS que producción)
# Rama Git recomendada: develop
# Ruta típica en servidor: /opt/hyvision-dev
# =================================================================
# Uso:
#   cp .env.dev.example .env
#   docker compose up -d hyvision-db
#   docker compose run --no-deps --rm -e INSTALL_TB=true -e LOAD_DEMO=true hyvision-app
#   docker compose up -d
# =================================================================

COMPOSE_PROJECT_NAME=hyvision-dev
HYVISION_STACK=hyvision-dev

HYVISION_VERSION=4.3.1.6

# Puertos distintos a prod (8082 / 5433 / 1884 en .env.example)
HYVISION_HTTP_PORT=8083
HYVISION_MQTT_PORT=1885
HYVISION_EDGE_PORT=7072
HYVISION_COAP_PORT=5690
POSTGRES_PORT=5434

POSTGRES_DB=hyvision
POSTGRES_USER=hyvision
POSTGRES_PASSWORD=hyvision_dev_pass_change_me

# VPS compartida: JVM más pequeña que producción
JAVA_OPTS=-Xms512m -Xmx2048m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
